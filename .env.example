APP_NAME=Prebook API
ENV=local
SECRET_KEY=change-me-in-production-please-use-32-chars-min
DATABASE_URL=postgresql+asyncpg://prebook:prebook@localhost:5432/prebook
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_MIN_LENGTH=8
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
REVIEW_RATE_LIMIT_ATTEMPTS=3
REVIEW_RATE_LIMIT_WINDOW_SECONDS=3600
STORAGE_ROOT=storage
STORAGE_PUBLIC_URL=/media
MAX_PDF_UPLOAD_BYTES=52428800
MAX_COVER_UPLOAD_BYTES=5242880
